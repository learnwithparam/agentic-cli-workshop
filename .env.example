# Copy this file to .env and fill in only what you use. .env is git-ignored. Never commit a key.
# With nothing set, everything runs on the practice model: no key, no cost.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Only for LLM_PROVIDER=ollama: the model you pulled, and where Ollama listens.
OLLAMA_MODEL=
OLLAMA_BASE_URL=
