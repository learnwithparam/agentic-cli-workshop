{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "config",
    "checks",
    "finished",
    "scripts",
    "tests",
    "world",
    "parts/**/solution",
    "00-orientation"
  ]
}
